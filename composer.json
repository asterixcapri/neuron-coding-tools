{
    "name": "asterixcapri/neuron-coding-tools",
    "description": "Reusable coding tools for Neuron AI agents: read, search, edit, write and run code.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alessandro Astarita",
            "email": "aleast@caprionline.it"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-posix": "*",
        "amphp/amp": "^3.0",
        "amphp/byte-stream": "^2.0",
        "amphp/file": "^3.0",
        "amphp/process": "^2.1",
        "neuron-core/neuron-ai": "^4.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "NeuronCodingTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeuronCodingTools\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit",
        "cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php"
    },
    "config": {
        "sort-packages": true
    }
}
